# 复制为 .env 并填入你的密钥：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。

# Moonshot / Kimi API Key（从 https://platform.moonshot.ai 或 platform.kimi.ai 获取）
MOONSHOT_API_KEY=

# API Base URL：海外用 .ai，国内用 .cn
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# 模型 ID：可选 kimi-k2.6 / kimi-k2.5 / kimi-k2.7 / kimi-latest
MOONSHOT_MODEL=kimi-k2.6

# 本地服务端口
PORT=5173
